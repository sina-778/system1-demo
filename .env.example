# Copy this file to ".env" and paste your keys after the "=" (no quotes, no spaces).
# The .env file stays on your computer and is ignored by git.

# From https://openrouter.ai/settings/keys  (needs a few dollars of credit)
OPENROUTER_API_KEY=

# From the KISSKI / GWDG "LLM Service" booking (same email as your Academic Cloud account)
GWDG_API_KEY=

# Jev version. "~typesafe/jev-latest" follows the newest release.
JEV_MODEL=~typesafe/jev-latest

# Which System 1 brain brains.py calls: "jev" (OpenRouter, paid) or "clm"
# (CLM-8B running locally on your Mac, free - see README "Run CLM-8B locally").
SYSTEM1_BACKEND=jev

# Only read when SYSTEM1_BACKEND=clm. Must match the port clm-serve was started with.
CLM_URL=http://127.0.0.1:8700/v1/systemone
