# Template for Streamlit Community Cloud's "Secrets" settings (app dashboard -> Settings -> Secrets).
# Paste this in, fill in your real keys, and save - do NOT commit a real secrets.toml to git.
# Locally, brains.py reads from .env instead; this file is only used when deployed.

OPENROUTER_API_KEY = "sk-or-..."
GWDG_API_KEY = "..."
JEV_MODEL = "~typesafe/jev-latest"

# Use "jev" for the deployed version. CLM-8B only runs on your own Mac (llama-server +
# clm-serve on localhost) - a cloud deployment can't reach it, so brains.py falls back to
# Jev automatically either way, but setting this explicitly avoids a pointless connection
# attempt on every single request.
SYSTEM1_BACKEND = "jev"
